GEARWATCH_APP_NAME=GearWatch Canada
GEARWATCH_APP_ENV=development
GEARWATCH_DEBUG=true
GEARWATCH_DATABASE_URL=postgresql+psycopg://gearwatch:gearwatch@localhost:5432/gearwatch
GEARWATCH_TEST_DATABASE_URL=postgresql+psycopg://gearwatch:gearwatch@localhost:5432/gearwatch_test
GEARWATCH_HTTP_TIMEOUT_SECONDS=10
GEARWATCH_HTTP_MAX_RETRIES=2
GEARWATCH_HTTP_BACKOFF_SECONDS=0.5
GEARWATCH_HTTP_MIN_INTERVAL_SECONDS=2.0
GEARWATCH_HTTP_USER_AGENT=GearWatchCanada/0.1 (scheduled portfolio project)
# Optional comma-separated, query-free product pages. Discovery-enabled adapters can
# collect without these; set GEARWATCH_CATALOG_DISCOVERY_ENABLED=false for URL-only mode.
GEARWATCH_ARCTERYX_OUTLET_PRODUCT_URLS=
GEARWATCH_ARCTERYX_CANADA_PRODUCT_URLS=
GEARWATCH_MONOD_SPORTS_PRODUCT_URLS=
GEARWATCH_VPO_PRODUCT_URLS=
GEARWATCH_THE_OUTFITTERS_PRODUCT_URLS=
GEARWATCH_CATALOG_DISCOVERY_ENABLED=true
GEARWATCH_CATALOG_DISCOVERY_MAX_PRODUCTS=15
GEARWATCH_CATALOG_DISCOVERY_MAX_PAGES=3
# Scheduled collection defaults to every 6 hours; minimum supported interval is 300 seconds.
GEARWATCH_COLLECTION_INTERVAL_SECONDS=21600
GEARWATCH_COLLECTION_RUN_ON_STARTUP=true

# Docker Compose development credentials only; use different values outside local development.
POSTGRES_DB=gearwatch
POSTGRES_USER=gearwatch
POSTGRES_PASSWORD=gearwatch
